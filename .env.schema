# API key for the Anthropic adapter used by the included chat demo.
# @sensitive @docs(https://docs.anthropic.com/en/api/getting-started)
ANTHROPIC_API_KEY=

# API key for the Gemini adapter used by the included AI demos.
# @sensitive @docs(https://ai.google.dev/gemini-api/docs/api-key)
GEMINI_API_KEY=

# API key for the OpenAI adapter used by the included AI demos.
# @sensitive @docs(https://platform.openai.com/api-keys)
OPENAI_API_KEY=